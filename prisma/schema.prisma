datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String       @id @default(cuid())
  name          String?
  username      String?      @unique
  email         String?      @unique
  emailVerified DateTime?
  image         String?
  initials      String?
  bg            String       @default("#B85428")
  accounts      Account[]
  sessions      Session[]
  threads       Discussion[]
  replies       Reply[]
  createdAt     DateTime     @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Category {
  id          String       @id
  name        String
  count       Int          @default(0)
  color       String
  discussions Discussion[]
}

model Discussion {
  id           String     @id @default(cuid())
  title        String
  excerpt      String
  body         String
  categoryId   String
  category     Category   @relation(fields: [categoryId], references: [id])
  authorId     String
  author       User       @relation(fields: [authorId], references: [id])
  pinned       Boolean    @default(false)
  views        Int        @default(0)
  likes        Int        @default(0)
  tags         String[]
  replies      Reply[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  lastActivity DateTime   @default(now())
}

model Reply {
  id           String     @id @default(cuid())
  content      String
  discussionId String
  discussion   Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  authorId     String
  author       User       @relation(fields: [authorId], references: [id])
  parentId     String?
  parent       Reply?     @relation("NestedReplies", fields: [parentId], references: [id], onDelete: Cascade)
  nested       Reply[]    @relation("NestedReplies")
  likes        Int        @default(0)
  createdAt    DateTime   @default(now())
}