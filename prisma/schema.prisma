datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id              String           @id @default(cuid())
  name            String?
  username        String?          @unique
  email           String?          @unique
  emailVerified   DateTime?
  image           String?
  initials        String?
  bg              String           @default("#B85428")
  accounts        Account[]
  sessions        Session[]
  discussions     Discussion[]
  posts           Post[]
  discussionLikes DiscussionLike[]
  postLikes       PostLike[]
  bookmarks       Bookmark[]
  reports         Report[]
  createdAt       DateTime         @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Category {
  id          String        @id
  name        String
  count       Int           @default(0)
  color       String
  megaThreads MegaThread[]
  discussions Discussion[]
}

model MegaThread {
  id               String       @id @default(cuid())
  title            String
  description      String
  categoryId       String
  category         Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  featured         Boolean      @default(false)
  tags             String[]
  discussionCount  Int          @default(0)
  participantCount Int          @default(0)
  discussions      Discussion[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([categoryId])
}

model Discussion {
  id              String           @id @default(cuid())
  title           String
  excerpt         String
  body            String
  megaThreadId    String?
  megaThread      MegaThread?      @relation(fields: [megaThreadId], references: [id], onDelete: SetNull)
  categoryId      String
  category        Category         @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  authorId        String
  author          User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  pinned          Boolean          @default(false)
  views           Int              @default(0)
  likes           Int              @default(0)
  shares          Int              @default(0)
  tags            String[]
  imageUrl        String?
  imageAlt        String?
  photographer    String?
  photographerUrl String?
  pexelsUrl       String?
  posts           Post[]
  discussionLikes DiscussionLike[]
  bookmarks       Bookmark[]
  reports         Report[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  lastActivity    DateTime         @default(now())

  @@index([categoryId])
  @@index([megaThreadId])
  @@index([authorId])
  @@index([createdAt])
}

model Post {
  id               String     @id @default(cuid())
  content          String
  discussionId     String
  discussion       Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  authorId         String
  author           User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  replyToPostId    String?
  replyToPost      Post?      @relation("PostReferences", fields: [replyToPostId], references: [id], onDelete: SetNull)
  referencingPosts Post[]     @relation("PostReferences")
  likes            Int        @default(0)
  postLikes        PostLike[]
  reports          Report[]
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@index([discussionId])
  @@index([authorId])
  @@index([replyToPostId])
  @@index([createdAt])
}

model DiscussionLike {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  discussionId String
  discussion   Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([userId, discussionId])
  @@index([discussionId])
  @@index([userId])
}

model PostLike {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, postId])
  @@index([postId])
  @@index([userId])
}

model Bookmark {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  discussionId String
  discussion   Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([userId, discussionId])
  @@index([discussionId])
  @@index([userId])
  @@index([createdAt])
}

model Report {
  id           String      @id @default(cuid())
  reason       String
  details      String?     @db.Text
  status       String      @default("PENDING")
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  discussionId String?
  discussion   Discussion? @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  postId       String?
  post         Post?       @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([userId])
  @@index([discussionId])
  @@index([postId])
  @@index([status])
  @@index([createdAt])
}