{
  "name": "website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "db:unseed": "npx tsx prisma/unseed.ts",
    "db:seed": "npx tsx prisma/seed.ts",
    "db:reset": "npx tsx prisma/unseed.ts && npx tsx prisma/seed.ts",
    "test": "npx tsx --test tests/*.test.ts",
    "pipeline:test": "npx tsx scripts/test-pipeline.ts",
    "postinstall": "prisma skills sync || exit 0",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "generate:all": "node scripts/generate-all-stories.mjs"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "dependencies": {
