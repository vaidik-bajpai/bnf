    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.45.0",
    "next": "16.3.5",
    "next-auth": "^5.0.0-beta.32",
    "ogl": "^1.0.11",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.2",
